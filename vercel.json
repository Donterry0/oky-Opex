{
  "buildCommand": "prisma generate && next build",
  "devCommand": "next dev",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_FIREBASE_API_KEY": "@oky_firebase_api_key",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "@oky_firebase_auth_domain",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "@oky_firebase_project_id",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "@oky_firebase_storage_bucket",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "@oky_firebase_messaging_sender_id",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "@oky_firebase_app_id",
    "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "@oky_firebase_measurement_id",
    "NEXT_PUBLIC_APP_URL": "https://oky-opex.vercel.app",
    "NODE_ENV": "production"
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "regions": ["iad1"]
}
